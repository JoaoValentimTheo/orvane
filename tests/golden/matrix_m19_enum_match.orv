// orv: run %f
enum Shape { Circle(Float), Rect(Float, Float) }

enum Flag { On, Off }

fn area(s: Shape) -> Float {
    match s {
        Circle(r) => 3.14159 * r * r,
        Rect(w, h) => w * h,
    }
}

fn main() {
    print(area(Rect(2.0, 3.0)))
    print(area(Circle(1.0)))
    let f = On
    match f {
        On => print("on"),
        Off => print("off"),
    }
    print(f == On)
    print(f == Off)
}
